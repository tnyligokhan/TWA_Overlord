@model TWA.Web.Models.CommandsViewModel
@{
    ViewData["Title"] = "Komutlar";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <h2 class="mb-1"><i class="fas fa-paper-plane text-warning"></i> Komutlar</h2>
                <p class="text-muted mb-0">Giden ve gelen asker hareketleri</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <div class="btn-group w-100" role="group">
                    <a href="@Url.Action("Index", new { type = "outgoing" })" 
                       class="btn @(Model.SelectedType == "outgoing" ? "btn-danger" : "btn-outline-secondary")">
                        <i class="fas fa-arrow-right"></i> Giden Komutlar
                    </a>
                    <a href="@Url.Action("Index", new { type = "incoming" })" 
                       class="btn @(Model.SelectedType == "incoming" ? "btn-warning" : "btn-outline-secondary")">
                        <i class="fas fa-arrow-left"></i> Gelen Komutlar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Commands.Any())
{
    <div class="row">
        <div class="col-12">
            <div class="card border-0 bg-glass">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="mb-0">Komut Listesi</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover">
                            <thead>
                                <tr>
                                    <th width="50"></th>
                                    <th>Kaynak</th>
                                    <th>Hedef</th>
                                    <th width="150">Varış</th>
                                    <th width="100">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var command in Model.Commands)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <i class="@command.Icon @command.ColorClass fa-2x"></i>
                                        </td>
                                        <td>
                                            <strong>@command.OriginVillage</strong>
                                        </td>
                                        <td>
                                            <strong>@command.TargetVillage</strong>
                                        </td>
                                        <td class="text-warning">
                                            @command.ArrivalTime.ToString("dd.MM.yyyy HH:mm:ss")
                                        </td>
                                        <td>
                                            @if (command.CanCancel)
                                            {
                                                <form method="post" asp-action="Cancel" asp-route-id="@command.Id" 
                                                      class="d-inline" onsubmit="return confirm('Komutu iptal etmek istediğinize emin misiniz?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-times"></i> İptal
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card border-0 bg-glass">
                <div class="card-body text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">Komut Bulunamadı</h4>
                    <p class="text-muted">Şu anda aktif komut bulunmuyor.</p>
                </div>
            </div>
        </div>
    </div>
}
