@model Dictionary<string, int>

@{
    ViewData["Title"] = "Bayraklar";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@ViewBag.VillageName - Bayrak Envanteri</h3>
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-warning">
                        <i class="fe fe-alert-triangle me-2"></i> Bu köy için henüz bayrak verisi senkronize edilmedi veya bayrak bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="row">
                        @foreach (var flag in Model)
                        {
                            // flag.Key format: type_level (e.g. "ResourceProduction_1")
                            var parts = flag.Key.Split('_');
                            var type = parts.Length > 0 ? parts[0] : flag.Key;
                            var level = parts.Length > 1 ? parts[1] : "1";
                            
                            <div class="col-sm-6 col-lg-3">
                                <div class="card p-3">
                                    <div class="d-flex align-items-center">
                                        <span class="stamp stamp-md bg-blue mr-3">
                                            @level
                                        </span>
                                        <div>
                                            <h4 class="m-0"><a href="javascript:void(0)">@type</a></h4>
                                            <small class="text-muted">Seviye @level</small>
                                        </div>
                                        <div class="ms-auto">
                                             <span class="badge bg-green">x @flag.Value</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
