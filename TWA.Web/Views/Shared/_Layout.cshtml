<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OVERLORD | @ViewData["Title"]</title>
    <!-- Fonts: Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 (Fixed Version) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/live-data-animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sync-animations.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar">
                <div class="text-center py-4">
                    <h3 class="fw-bold"><i class="fas fa-shield-alt text-danger"></i> TWA <span style="color:var(--accent-cyan)">v3.2</span></h3>
                    <small class="text-muted">PROJECT OVERLORD</small>
                </div>
                <hr style="border-color: var(--border-color)">
                
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-tachometer-alt"></i> KOMUTA MERKEZİ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Village" ? "active" : "")" asp-controller="Village" asp-action="Index">
                            <i class="fas fa-chess-rook"></i> KÖYLER
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Warfare" ? "active" : "")" asp-controller="Warfare" asp-action="Index">
                            <i class="fas fa-crosshairs"></i> SAVAŞ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Map" ? "active" : "")" asp-controller="Map" asp-action="Index">
                            <i class="fas fa-map-marked-alt"></i> HARİTA
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index">
                            <i class="fas fa-cog"></i> AYARLAR
                        </a>
                    </li>
                </ul>
                
                <div class="position-absolute bottom-0 w-100 p-3 text-muted text-center" style="font-size: 0.7rem;">
                    Server Time: <span id="server-clock">--:--:--</span><br>
                    Groq AI: <span class="text-success">ONLINE ●</span>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                <!-- Global Toolbar -->
                <div class="d-flex justify-content-between align-items-center mb-4 fade-in-down">
                    <div>
                        <h4 class="mb-0 fw-bold text-white">
                            <i class="fas fa-rocket me-2 text-primary"></i> 
                            @ViewData["Title"]
                        </h4>
                        <small class="text-muted">OVERLORD v3.2 // CONNECTED</small>
                    </div>
                    
                    <div class="d-flex gap-3 align-items-center">
                        <!-- Server Time Pill -->
                        <div class="d-flex align-items-center px-3 py-2 rounded-pill" style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);">
                            <i class="fas fa-globe me-2 text-muted"></i>
                            <span id="server-clock-main" class="font-monospace fw-bold text-white">--:--:--</span>
                        </div>

                        <!-- Connect Action -->
                        <button id="btn-connect-global" class="btn btn-success d-flex align-items-center gap-2">
                            <i class="fas fa-plug"></i> <span>OYUNA BAĞLAN</span>
                        </button>

                        <!-- Sync Data -->
                        <button id="btn-sync-global" data-sync-all class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="fas fa-sync"></i> <span>VERİ SENKRONIZE ET</span>
                        </button>
                        
                        <a href="@Url.Action("Index", "Settings")" class="btn btn-icon btn-outline-light rounded-circle" style="width: 42px; height: 42px;">
                            <i class="fas fa-cog"></i>
                        </a>
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/sync-service.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Global Clock Update
        setInterval(() => {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('tr-TR', { hour12: false });
            $('#server-clock-main').text(timeStr);
            $('#server-clock').text(timeStr);
        }, 1000);

        // Global Connection State Management
        let isConnected = false;

        function checkConnectionStatus() {
            $.get('/Dashboard/GetConnectionStatus', function(data) {
                if (data.isConnected) {
                    setConnectedState();
                } else {
                    setDisconnectedState();
                }
            }).fail(function() {
                setDisconnectedState();
            });
        }

        function setConnectedState() {
            isConnected = true;
            const btn = $('#btn-connect-global');
            btn.prop('disabled', true)
               .removeClass('btn-success')
               .addClass('btn-outline-success')
               .html('<i class="fas fa-link"></i> BAĞLANTI (ONLINE)');
        }

        function setDisconnectedState() {
            isConnected = false;
            const btn = $('#btn-connect-global');
            btn.prop('disabled', false)
               .removeClass('btn-outline-success')
               .addClass('btn-success')
               .html('<i class="fas fa-plug"></i> OYUNA BAĞLAN');
        }

        // Global Connect Button
        $(document).on('click', '#btn-connect-global', function() {
            if (isConnected) return;

            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-circle-notch fa-spin"></i> BAĞLANILIYOR...');
            
            $.post('/Dashboard/ConnectGame', function(data) {
                if(data.success) {
                    setConnectedState();
                    window.syncService.showSuccessNotification(data.message);
                } else {
                    setDisconnectedState();
                    window.syncService.showErrorNotification(data.message || 'Bağlantı hatası');
                }
            }).fail(function() {
                setDisconnectedState();
                window.syncService.showErrorNotification('Sunucu bağlantı hatası');
            });
        });

        // Check connection on page load
        $(document).ready(function() {
            checkConnectionStatus();
        });
    </script>
    
    <script>
        // Basit Saat Scripti
        setInterval(() => {
            const now = new Date();
            document.getElementById('server-clock').innerText = now.toLocaleTimeString();
        }, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
