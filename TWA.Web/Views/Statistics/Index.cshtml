@model TWA.Web.Models.StatisticsViewModel
@{
    ViewData["Title"] = "İstatistikler";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <h2 class="mb-1"><i class="fas fa-chart-bar text-info"></i> İstatistikler</h2>
                <p class="text-muted mb-0">Genel Performans ve Köy İstatistikleri</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 bg-glass">
            <div class="card-body text-center">
                <i class="fas fa-chess-rook text-primary fa-3x mb-3"></i>
                <h3 class="text-white mb-0">@Model.TotalVillages</h3>
                <small class="text-muted">Toplam Köy</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass">
            <div class="card-body text-center">
                <i class="fas fa-users text-warning fa-3x mb-3"></i>
                <h3 class="text-white mb-0">@Model.TotalPopulation</h3>
                <small class="text-muted">Toplam Nüfus</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass">
            <div class="card-body text-center">
                <i class="fas fa-shield-alt text-success fa-3x mb-3"></i>
                <h3 class="text-white mb-0">@Model.TotalTroops</h3>
                <small class="text-muted">Toplam Asker</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass">
            <div class="card-body text-center">
                <i class="fas fa-boxes text-info fa-3x mb-3"></i>
                <h3 class="text-white mb-0">@Model.TotalResources.ToString("N0")</h3>
                <small class="text-muted">Toplam Kaynak</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-header bg-transparent border-bottom border-secondary">
                <h5 class="mb-0"><i class="fas fa-list"></i> Köy İstatistikleri</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Köy Adı</th>
                                <th>Koordinat</th>
                                <th>Puan</th>
                                <th>Nüfus</th>
                                <th>Asker</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.VillageStats.Count; i++)
                            {
                                var stat = Model.VillageStats[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Village", new { id = stat.VillageId })" 
                                           class="text-white text-decoration-none">
                                            <strong>@stat.VillageName</strong>
                                        </a>
                                    </td>
                                    <td class="text-muted">@stat.Coordinates</td>
                                    <td class="text-warning">@stat.Points</td>
                                    <td class="text-info">@stat.Population</td>
                                    <td class="text-success">@stat.TotalTroops</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Village", new { id = stat.VillageId })" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
