@model TWA.Web.Models.TransportsViewModel
@{
    ViewData["Title"] = "Sevkiyatlar";
}

<div class="row">
    <div class="col-12">
        <div class="card bg-glass">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-truck text-info"></i> Lojistik Ağı</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info border-info bg-dark text-white">
                    <i class="fas fa-info-circle"></i> Sevkiyat takip modülü henüz aktif değil. Buradan sadece manuel eklenen veya market aktivitesinden yakalanan sevkiyatlar görüntülenecektir.
                </div>
                
                <ul class="nav nav-tabs mb-3" id="transportsTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="incoming-tab" data-bs-toggle="tab" href="#incoming" role="tab">Incoming</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="outgoing-tab" data-bs-toggle="tab" href="#outgoing" role="tab">Outgoing</a>
                    </li>
                </ul>
                
                <div class="tab-content" id="transportsTabContent">
                    <div class="tab-pane fade show active" id="incoming" role="tabpanel">
                        @if(Model.IncomingTransports.Any()) {
                            <p>Liste...</p>
                        } else {
                            <div class="text-center py-4 text-muted">
                                Gelen sevkiyat yok.
                            </div>
                        }
                    </div>
                    <div class="tab-pane fade" id="outgoing" role="tabpanel">
                        @if(Model.OutgoingTransports.Any()) {
                            <p>Liste...</p>
                        } else {
                            <div class="text-center py-4 text-muted">
                                Giden sevkiyat yok.
                            </div>
                        }
                    </div>
                </div>
            </div>
             <div class="card-footer">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>
