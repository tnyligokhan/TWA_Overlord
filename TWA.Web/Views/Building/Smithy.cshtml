@model TWA.Web.Models.SmithyViewModel
@{
    ViewData["Title"] = "Demirci - Araştırma";
    
    var researchList = new List<TWA.Web.Models.ResearchInfo>
    {
        new() { UnitType = "spear", UnitName = "Mızrakçı", CurrentLevel = Model.SelectedVillage?.ResearchSpear ?? 0, MaxLevel = 1, WoodCost = 1200, StoneCost = 1000, IronCost = 800, RequiredSmithyLevel = 1, RequiredBarracksLevel = 1, BuildingRequirement = "Kışla (1)" },
        new() { UnitType = "sword", UnitName = "Kılıç Ustası", CurrentLevel = Model.SelectedVillage?.ResearchSword ?? 0, MaxLevel = 1, WoodCost = 1400, StoneCost = 1600, IronCost = 1800, RequiredSmithyLevel = 1, RequiredBarracksLevel = 1, BuildingRequirement = "Kışla (1)" },
        new() { UnitType = "axe", UnitName = "Baltacı", CurrentLevel = Model.SelectedVillage?.ResearchAxe ?? 0, MaxLevel = 1, WoodCost = 1700, StoneCost = 1400, IronCost = 1800, RequiredSmithyLevel = 2, RequiredBarracksLevel = 2, BuildingRequirement = "Kışla (2)" },
        new() { UnitType = "spy", UnitName = "Casus", CurrentLevel = Model.SelectedVillage?.ResearchSpy ?? 0, MaxLevel = 1, WoodCost = 1600, StoneCost = 1800, IronCost = 1400, RequiredSmithyLevel = 5, RequiredStableLevel = 1, BuildingRequirement = "Ahır (1)" },
        new() { UnitType = "light", UnitName = "Hafif Süvari", CurrentLevel = Model.SelectedVillage?.ResearchLight ?? 0, MaxLevel = 1, WoodCost = 2000, StoneCost = 2200, IronCost = 1800, RequiredSmithyLevel = 5, RequiredStableLevel = 3, BuildingRequirement = "Ahır (3)" },
        new() { UnitType = "heavy", UnitName = "Ağır Süvari", CurrentLevel = Model.SelectedVillage?.ResearchHeavy ?? 0, MaxLevel = 1, WoodCost = 2400, StoneCost = 2000, IronCost = 2600, RequiredSmithyLevel = 10, RequiredStableLevel = 5, BuildingRequirement = "Ahır (5)" },
        new() { UnitType = "ram", UnitName = "Koç", CurrentLevel = Model.SelectedVillage?.ResearchRam ?? 0, MaxLevel = 1, WoodCost = 2200, StoneCost = 2400, IronCost = 2000, RequiredSmithyLevel = 12, RequiredGarageLevel = 2, BuildingRequirement = "Atölye (2)" },
        new() { UnitType = "catapult", UnitName = "Mancınık", CurrentLevel = Model.SelectedVillage?.ResearchCatapult ?? 0, MaxLevel = 1, WoodCost = 2400, StoneCost = 2600, IronCost = 2200, RequiredSmithyLevel = 15, RequiredGarageLevel = 5, BuildingRequirement = "Atölye (5)" }
    };
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1"><i class="fas fa-hammer text-warning"></i> Demirci</h2>
                        <p class="text-muted mb-0">Birliklerin Savaş Gücünü Artır</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark border border-secondary text-warning fs-5">Seviye @(Model.SelectedVillage?.BuildingSmithy ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <label class="form-label text-white fw-bold">Köy Seçin:</label>
                <select class="form-select bg-dark text-white border-secondary" onchange="window.location.href='/Building/Smithy?villageId=' + this.value">
                    @foreach (var village in Model.Villages)
                    {
                        <option value="@village.Id" selected="@(village.Id == Model.SelectedVillageId)">
                            @village.Name (@village.Coordinates) - Demirci Lv.@village.BuildingSmithy
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (Model.SelectedVillage != null)
{
    @await Html.PartialAsync("_BuildingNavbar", Model.SelectedVillage)
    
    var capacity = Model.SelectedVillage.StorageCapacity > 0 ? Model.SelectedVillage.StorageCapacity : 1;
    var woodP = (int)((double)Model.SelectedVillage.Wood / capacity * 100);
    var stoneP = (int)((double)Model.SelectedVillage.Stone / capacity * 100);
    var ironP = (int)((double)Model.SelectedVillage.Iron / capacity * 100);
    var popMax = Model.SelectedVillage.PopulationMax > 0 ? Model.SelectedVillage.PopulationMax : 1;
    var popP = (int)((double)Model.SelectedVillage.PopulationCurrent / popMax * 100);

    <div class="row g-4 mb-4 fade-in-up" style="animation-delay: 0.1s;">
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-tree text-success me-2"></i> Odun</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Wood.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-success progress-bar-animated-striped" style="width: @woodP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-success"></i>@Model.SelectedVillage.WoodHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@woodP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-cubes text-secondary me-2"></i> Kil</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Stone.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-secondary progress-bar-animated-striped" style="width: @stoneP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-secondary"></i>@Model.SelectedVillage.StoneHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@stoneP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-gem text-info me-2"></i> Demir</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Iron.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-info progress-bar-animated-striped" style="width: @ironP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-info"></i>@Model.SelectedVillage.IronHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@ironP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-warehouse text-warning me-2"></i> Depo</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.StorageCapacity.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @Math.Max(woodP, Math.Max(stoneP, ironP))%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">Kapasite</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var research in researchList)
        {
            var canResearch = true;
            var missingRequirements = new List<string>();
            
            // Demirci seviye kontrolü
            if (Model.SelectedVillage.BuildingSmithy < research.RequiredSmithyLevel)
            {
                canResearch = false;
                missingRequirements.Add($"Demirci ({research.RequiredSmithyLevel})");
            }
            
            // Bina gereksinimleri
            if (research.RequiredBarracksLevel > 0 && Model.SelectedVillage.BuildingBarracks < research.RequiredBarracksLevel)
            {
                canResearch = false;
                missingRequirements.Add(research.BuildingRequirement);
            }
            if (research.RequiredStableLevel > 0 && Model.SelectedVillage.BuildingStable < research.RequiredStableLevel)
            {
                canResearch = false;
                missingRequirements.Add(research.BuildingRequirement);
            }
            if (research.RequiredGarageLevel > 0 && Model.SelectedVillage.BuildingGarage < research.RequiredGarageLevel)
            {
                canResearch = false;
                missingRequirements.Add(research.BuildingRequirement);
            }
            
            // Kaynak kontrolü
            var hasResources = Model.SelectedVillage.Wood >= research.WoodCost && 
                              Model.SelectedVillage.Stone >= research.StoneCost && 
                              Model.SelectedVillage.Iron >= research.IronCost;
            
            // Kaynak yetme zamanı hesaplama
            var woodNeeded = Math.Max(0, research.WoodCost - Model.SelectedVillage.Wood);
            var stoneNeeded = Math.Max(0, research.StoneCost - Model.SelectedVillage.Stone);
            var ironNeeded = Math.Max(0, research.IronCost - Model.SelectedVillage.Iron);
            
            var woodHours = Model.SelectedVillage.WoodHourly > 0 ? (double)woodNeeded / Model.SelectedVillage.WoodHourly : 0;
            var stoneHours = Model.SelectedVillage.StoneHourly > 0 ? (double)stoneNeeded / Model.SelectedVillage.StoneHourly : 0;
            var ironHours = Model.SelectedVillage.IronHourly > 0 ? (double)ironNeeded / Model.SelectedVillage.IronHourly : 0;
            
            var maxHours = Math.Max(woodHours, Math.Max(stoneHours, ironHours));
            var resourcesAvailableAt = DateTime.Now.AddHours(maxHours);
            
            var isMaxLevel = research.CurrentLevel >= research.MaxLevel;
            
            <div class="col-md-6 mb-4">
                <div class="card border-0 bg-glass h-100 @(canResearch && !isMaxLevel ? "" : "opacity-75")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_@(research.UnitType).webp" 
                                     width="60" alt="@research.UnitName" class="me-3">
                                <div>
                                    <h5 class="text-white mb-1">@research.UnitName</h5>
                                    @if (isMaxLevel)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                            <i class="fas fa-check me-1"></i> Araştırıldı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">
                                            <i class="fas fa-lock me-1"></i> Araştırılmamış
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!isMaxLevel)
                        {
                            @if (missingRequirements.Any())
                            {
                                <!-- Koşullar karşılanmıyor - sadece eksik koşulları göster -->
                                <div class="alert alert-warning bg-warning bg-opacity-10 border border-warning mb-3 py-2">
                                    <small>
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        <strong>Karşılanmayan koşullar:</strong> @string.Join(", ", missingRequirements)
                                    </small>
                                </div>
                            }
                            else
                            {
                                <!-- Koşullar karşılanıyor - maliyet ve kaynak durumunu göster -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between text-white">
                                        <span class="@(Model.SelectedVillage.Wood >= research.WoodCost ? "text-success" : "text-danger")">
                                            Odun @research.WoodCost
                                        </span>
                                        <span class="@(Model.SelectedVillage.Stone >= research.StoneCost ? "text-success" : "text-danger")">
                                            Kil @research.StoneCost
                                        </span>
                                        <span class="@(Model.SelectedVillage.Iron >= research.IronCost ? "text-success" : "text-danger")">
                                            Demir @research.IronCost
                                        </span>
                                    </div>
                                </div>

                                @if (!hasResources)
                                {
                                    <div class="alert alert-info bg-info bg-opacity-10 border border-info mb-3 py-2">
                                        <small>
                                            <i class="fas fa-clock me-1"></i>
                                            <strong>Mevcut hammaddeler</strong>
                                            @if (maxHours < 1)
                                            {
                                                <span>bugün saat @resourcesAvailableAt.ToString("HH:mm")</span>
                                            }
                                            else if (maxHours < 24)
                                            {
                                                var tomorrow = DateTime.Today.AddDays(1);
                                                if (resourcesAvailableAt.Date == tomorrow)
                                                {
                                                    <span>yarın saat @resourcesAvailableAt.ToString("HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span>bugün saat @resourcesAvailableAt.ToString("HH:mm")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>@resourcesAvailableAt.ToString("dd.MM.yyyy HH:mm")</span>
                                            }
                                        </small>
                                    </div>
                                }
                            }

                            @if (canResearch && hasResources)
                            {
                                <button class="btn btn-success w-100">
                                    <i class="fas fa-flask me-1"></i> Araştır
                                </button>
                            }
                            else if (canResearch)
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>
                                    <i class="fas fa-hourglass-half me-1"></i> Yetersiz Kaynak
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary w-100" disabled>
                                    <i class="fas fa-lock me-1"></i> Gereksinimler Karşılanmadı
                                </button>
                            }
                        }
                        else
                        {
                            <div class="alert alert-success bg-success bg-opacity-10 border border-success mb-0">
                                <i class="fas fa-trophy me-2"></i>
                                <strong>Tamamlandı!</strong> Bu birim maksimum seviyeye ulaştı.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
