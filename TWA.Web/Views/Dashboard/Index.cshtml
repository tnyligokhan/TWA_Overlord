@using TWA.Core.Entities
@model TWA.Web.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "KOMUTA MERKEZİ";
}

<!-- HUD STATS (Bento Grid) -->
<div class="row g-4 mb-4">
    <!-- Village Count -->
    <div class="col-md-3">
        <div class="card hud-stat-card border-primary">
            <h4 class="hud-stat-value text-primary">@Model.TotalVillages</h4>
            <span class="hud-stat-label">TOPLAM KÖY</span>
            <i class="fas fa-city hud-watermark text-primary"></i>
        </div>
    </div>
    
    <!-- Points -->
    <div class="col-md-3">
        <div class="card hud-stat-card border-warning">
            <h4 class="hud-stat-value text-warning">@Model.TotalPoints.ToString("N0")</h4>
            <span class="hud-stat-label">TOPLAM PUAN</span>
            <i class="fas fa-trophy hud-watermark text-warning"></i>
        </div>
    </div>
    
    <!-- Active Ops -->
    <div class="col-md-3">
        <div class="card hud-stat-card border-danger">
            <h4 class="hud-stat-value text-danger">@Model.ActiveAttacks</h4>
            <span class="hud-stat-label">AKTİF OPERASYON</span>
            <i class="fas fa-crosshairs hud-watermark text-danger"></i>
        </div>
    </div>
    
    <!-- Logistics -->
    <div class="col-md-3">
        <div class="card hud-stat-card border-info">
            <h4 class="hud-stat-value text-info">@Model.LowStorageVillages</h4>
            <span class="hud-stat-label">LOJİSTİK UYARISI</span>
            <i class="fas fa-truck-loading hud-watermark text-info"></i>
        </div>
    </div>
</div>

<!-- ECO PANEL (Widget Row) -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card bg-glass border-warning h-100">
            <div class="card-header bg-transparent border-warning text-warning fw-bold">
                <i class="fas fa-coins me-2"></i> DARPHANE DURUMU
            </div>
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="text-white mb-0">@Model.TotalGoldCoins</h2>
                    <small class="text-muted">Toplam Altın Para (Tahmini)</small>
                    <div class="mt-2 text-success small">
                        <i class="fas fa-info-circle me-1"></i> Akademi seviyesine göre
                    </div>
                </div>
                <div class="coin-spinner position-relative">
                    <div class="spinner-border text-warning" style="width: 4rem; height: 4rem;" role="status"></div>
                    <i class="fas fa-gavel position-absolute top-50 start-50 translate-middle text-warning"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <button class="btn btn-sm btn-outline-warning w-100" onclick="TriggerMinting()">
                    <i class="fas fa-sync me-2"></i> Zorla Bas
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-glass h-100">
            <div class="card-header bg-transparent text-info fw-bold">
                <i class="fas fa-truck-loading me-2"></i> LOJİSTİK AĞI
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if(Model.ActiveLogistics.Any())
                    {
                        @foreach(var route in Model.ActiveLogistics)
                        {
                            <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-dark border border-secondary">@route.SourceVillageName</span>
                                    <i class="fas fa-arrow-right text-muted mx-2"></i>
                                    <span class="badge bg-dark border border-secondary">@route.TargetVillageName</span>
                                </div>
                                <small class="text-muted"><i class="fas fa-clock me-1"></i> @route.ArrivalTime</small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item bg-transparent text-white text-center py-4">
                            <i class="fas fa-check-circle text-success mb-2"></i><br>
                            <small class="text-muted">Aktif lojistik hareketi yok</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. MAIN CONTENT (Split View) -->
<div class="row g-4 flex-grow-1" style="min-height: 0;"> <!-- min-height:0 for nested flex scroll -->
    
    <!-- LEFT PANEL: Operations (Floating Table) -->
    <div class="col-lg-8">
        <div class="glass-panel p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0 text-white"><i class="fas fa-list-ul me-2 text-muted"></i> BEKLEYEN SAVAŞ EMİRLERİ</h5>
                <span class="badge bg-primary"><i class="fas fa-satellite-dish me-1"></i> CANLI</span>
            </div>
            
            <div class="table-responsive">
                <table class="floating-table">
                    <thead>
                        <tr>
                            <th>HEDEF</th>
                            <th>GÖREV TÜRÜ</th>
                            <th>ÇIKIŞ ZAMANI</th>
                            <th>BİRLİK</th>
                            <th>DURUM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.ActiveAttacks == 0)
                        {
                            <tr class="floating-row">
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fas fa-check-circle mb-2 fa-2x opacity-25"></i><br>
                                    Bekleyen emir yok Komutanım. Sistem beklemede.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach(var attack in Model.ActiveAttackList)
                            {
                                <tr class="floating-row">
                                    <td>
                                        <div class="fw-bold text-white">@attack.TargetPlayerName (@attack.TargetX|@attack.TargetY)</div>
                                        <small class="text-muted">@(attack.SourceVillage?.Name ?? "Köy")</small>
                                    </td>
                                    <td>
                                        @switch(attack.Type)
                                        {
                                            case AttackType.Fake:
                                                <span class="badge bg-secondary text-secondary bg-opacity-10">FAKE</span>
                                                break;
                                            case AttackType.Farm:
                                                <span class="badge bg-warning text-warning bg-opacity-10">YAĞMA</span>
                                                break;
                                            case AttackType.Real_Nuke:
                                                <span class="badge bg-danger text-danger bg-opacity-10">KAMI</span>
                                                break;
                                            case AttackType.Real_Noble:
                                                <span class="badge bg-danger text-danger bg-opacity-10">MİSYONER</span>
                                                break;
                                            case AttackType.Snipe:
                                                <span class="badge bg-info text-info bg-opacity-10">SNIPE</span>
                                                break;
                                            case AttackType.Support:
                                                <span class="badge bg-success text-success bg-opacity-10">DESTEK</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace"><i class="fas fa-stopwatch me-1"></i> @attack.LaunchTime.ToString("HH:mm:ss")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-users text-muted"></i> 
                                            <span class="text-white">
                                                @if(attack.Troops.Spear > 0) { <text>@attack.Troops.Spear Miz </text> }
                                                @if(attack.Troops.Sword > 0) { <text>@attack.Troops.Sword Kıl </text> }
                                                @if(attack.Troops.Axe > 0) { <text>@attack.Troops.Axe Bal </text> }
                                                @if(attack.Troops.Light > 0) { <text>@attack.Troops.Light Haf </text> }
                                                @if(attack.Troops.Heavy > 0) { <text>@attack.Troops.Heavy Ağır </text> }
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @switch(attack.Status)
                                        {
                                            case AttackStatus.Pending:
                                                <span class="status-dot bg-secondary"></span>
                                                <span class="text-secondary fw-bold small">BEKLİYOR</span>
                                                break;
                                            case AttackStatus.Scheduled:
                                                <span class="status-dot pulse bg-warning"></span>
                                                <span class="text-warning fw-bold small">ZAMANLI</span>
                                                break;
                                            case AttackStatus.Sent:
                                                <span class="status-dot pulse bg-success"></span>
                                                <span class="text-success fw-bold small">GÖNDERİLDİ</span>
                                                break;
                                            case AttackStatus.Cancelled:
                                                <span class="status-dot bg-danger"></span>
                                                <span class="text-danger fw-bold small">İPTAL</span>
                                                break;
                                            case AttackStatus.Failed:
                                                <span class="status-dot bg-danger"></span>
                                                <span class="text-danger fw-bold small">HATA</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL: Command Center (Tabs) -->
    <div class="col-lg-4">
        <div class="glass-panel h-100 d-flex flex-column overflow-hidden">
            <!-- Tabs Header -->
            <ul class="nav cmd-tabs border-bottom border-light border-opacity-10" id="cmdTab" role="tablist">
                <li class="nav-item flex-fill text-center" role="presentation">
                    <button class="nav-link active w-100" id="ai-tab" data-bs-toggle="tab" data-bs-target="#ai-panel" type="button" role="tab">
                        <i class="fas fa-brain me-2"></i>AI ASİSTAN
                    </button>
                </li>
                <li class="nav-item flex-fill text-center" role="presentation">
                    <button class="nav-link w-100" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs-panel" type="button" role="tab">
                        <i class="fas fa-terminal me-2"></i>SİSTEM LOG
                    </button>
                </li>
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content flex-grow-1 d-flex flex-column h-100" id="cmdTabContent" style="min-height: 400px;">
                
                <!-- AI Panel -->
                <div class="tab-pane fade show active h-100 p-3 d-flex flex-column" id="ai-panel" role="tabpanel">
                    <div id="chat-history" class="flex-grow-1 mb-3 overflow-auto pe-2 custom-scroll">
                        <!-- Welcome Message -->
                        <div class="chat-bubble chat-left">
                            <strong class="text-info d-block mb-1"><i class="fas fa-robot me-1"></i> OVERLORD</strong>
                            Emredersiniz Komutanım. Analizler tamamlandı. K45 bölgesinde 12 sahipsiz barbar tespit ettim. Emir bekliyorum.
                        </div>
                    </div>
                    
                    <div class="mt-auto">
                        <div class="input-group">
                            <input type="text" id="groq-input" class="form-control" placeholder="Bir emir giriniz..." style="border-right: none;">
                            <button class="btn btn-outline-light" id="btn-send-groq" style="border-left: none; border-color: var(--glass-border); background: rgba(255,255,255,0.05);">
                                <i class="fas fa-paper-plane text-primary"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Logs Panel -->
                <div class="tab-pane fade h-100" id="logs-panel" role="tabpanel">
                    <div id="system-log-window" class="cmd-log-window p-3 h-100 custom-scroll">
                        <div class="mb-1">
                            <span class="text-muted small me-2">[<span class="log-time">--:--:--</span>]</span>
                            <span class="text-info fw-bold">SYS:</span> <span class="text-white">Sistem başlatılıyor...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/gameDataHub")
            .withAutomaticReconnect()
            .build();

        // System Log Handler
        connection.on("SystemLogReceived", function (data) {
            const logWindow = document.getElementById("system-log-window");
            const logEntry = document.createElement("div");
            logEntry.className = "mb-1 fade-in";
            
            let levelClass = "text-info";
            let levelIcon = "info-circle";
            
            switch(data.level) {
                case "SUCCESS":
                    console.log(`%c[SUCCESS] ${data.message}`, 'color: green; font-weight: bold;');
                    levelClass = "text-success";
                    levelIcon = "check-circle";
                    break;
                case "ERROR":
                    console.error(`[ERROR] ${data.message}`);
                    if (data.stackTrace) console.error("StackTrace:", data.stackTrace);
                    if (data.source) console.error("Source:", data.source);
                    levelClass = "text-danger";
                    levelIcon = "exclamation-triangle";
                    break;
                case "WARNING":
                    console.warn(`[WARNING] ${data.message}`);
                    levelClass = "text-warning";
                    levelIcon = "exclamation-circle";
                    break;
                default:
                    console.log(`[${data.level}] ${data.message}`);
                    break;
            }
            
            logEntry.innerHTML = `
                <span class="text-muted small me-2">[${data.timestamp}]</span>
                <span class="${levelClass} fw-bold"><i class="fas fa-${levelIcon} me-1"></i>${data.level}:</span>
                <span class="text-white">${data.message}</span>
            `;
            
            logWindow.appendChild(logEntry);
            
            // Auto-scroll to bottom
            logWindow.scrollTop = logWindow.scrollHeight;
            
            // Keep only last 50 logs
            while (logWindow.children.length > 50) {
                logWindow.removeChild(logWindow.firstChild);
            }
        });

        // Resources Update Handler
        connection.on("ResourcesUpdated", function (data) {
            console.log("Resources updated for village:", data.villageId);
            // Update UI if needed
        });

        // Troops Update Handler
        connection.on("TroopsUpdated", function (data) {
            console.log("Troops updated for village:", data.villageId);
            // Update UI if needed
        });

        // Start Connection
        connection.start()
            .then(function () {
                console.log("SignalR Connected");
                addSystemLog("INFO", "SignalR bağlantısı kuruldu");
            })
            .catch(function (err) {
                console.error("SignalR Connection Error:", err);
                addSystemLog("ERROR", "SignalR bağlantı hatası: " + err.toString());
            });

        // Helper function to add log manually
        function addSystemLog(level, message) {
            const timestamp = new Date().toLocaleTimeString('tr-TR', { hour12: false });
            connection.invoke("BroadcastSystemLog", level, message).catch(function (err) {
                console.error("Log broadcast error:", err);
            });
        }

        // Clock
        setInterval(() => {
            document.getElementById('server-clock').innerText = new Date().toLocaleTimeString();
        }, 1000);

        // Check connection status on page load
        checkConnectionStatus();

        // Connection State Management
        let isConnected = false;

        // Check connection status on page load
        function checkConnectionStatus() {
            $.get('/Dashboard/GetConnectionStatus', function(data) {
                if (data.isConnected) {
                    setConnectedState();
                } else {
                    setDisconnectedState();
                }
            }).fail(function() {
                setDisconnectedState();
            });
        }

        function setConnectedState() {
            isConnected = true;
            const btn = $('#btn-connect-global');
            btn.prop('disabled', true)
               .removeClass('btn-success')
               .addClass('btn-outline-success')
               .html('<i class="fas fa-link"></i> BAĞLANTI (ONLINE)');
        }

        function setDisconnectedState() {
            isConnected = false;
            const btn = $('#btn-connect-global');
            btn.prop('disabled', false)
               .removeClass('btn-outline-success')
               .addClass('btn-success')
               .html('<i class="fas fa-plug"></i> OYUNA BAĞLAN');
        }

        // Connect Button Animation
        $('#btn-connect-global').click(function() {
            if (isConnected) return; // Already connected, do nothing

            var btn = $(this);
            
            btn.prop('disabled', true).html('<i class="fas fa-circle-notch fa-spin"></i> BAĞLANILIYOR...');
            
            addSystemLog("INFO", "Oyuna bağlanılıyor...");
            
            $.post('/Dashboard/ConnectGame', function(data) {
                if(data.success) {
                    setConnectedState();
                    
                    addSystemLog("SUCCESS", data.message);
                    
                    // Show success message in chat
                    $('#chat-history').append(`
                        <div class="chat-bubble chat-left">
                            <strong class="text-success d-block mb-1"><i class="fas fa-check-circle me-1"></i> SİSTEM</strong>
                            ${data.message}
                        </div>
                    `);
                    scrollToBottom();
                } else {
                    setDisconnectedState();
                    
                    addSystemLog("ERROR", data.message || 'Bilinmeyen hata');
                    
                    // Show error message in chat
                    $('#chat-history').append(`
                        <div class="chat-bubble chat-left">
                            <strong class="text-danger d-block mb-1"><i class="fas fa-exclamation-triangle me-1"></i> HATA</strong>
                            ${data.message || 'Bilinmeyen bir hata oluştu.'}
                        </div>
                    `);
                    scrollToBottom();
                }
            }).fail(function(xhr, status, error) {
                setDisconnectedState();
                
                addSystemLog("ERROR", "Bağlantı hatası: " + error);
                
                // Show network error in chat
                $('#chat-history').append(`
                    <div class="chat-bubble chat-left">
                        <strong class="text-danger d-block mb-1"><i class="fas fa-exclamation-triangle me-1"></i> BAĞLANTI HATASI</strong>
                        Sunucuya bağlanılamadı: ${error}
                    </div>
                `);
                scrollToBottom();
            });
        });

        // Sync Village Data (AJAX - No Page Reload)
        $('#btn-sync-global').click(function(e) {
            e.preventDefault();
            window.syncService.syncAllVillages();
        });
                    }
                });
            });
        });

        // Trigger Minting
        function TriggerMinting() {
            var btn = $(event.target).closest('button');
            var originalContent = btn.html();
            
            btn.prop('disabled', true).html('<i class="fas fa-cog fa-spin"></i> İşleniyor...');
            
            // Post to backend (Demo)
            setTimeout(() => {
                btn.prop('disabled', false).html('<i class="fas fa-check"></i> Emredildi');
                setTimeout(() => { btn.html(originalContent); }, 2000);
            }, 1000);
        }

        // Simple Chat Logic
        function sendMessage() {
            var input = $('#groq-input');
            var msg = input.val();
            if(!msg) return;

            // User Bubble
            $('#chat-history').append(`
                <div class="chat-bubble chat-right">
                    ${msg}
                </div>
            `);
            
            input.val('');
            scrollToBottom();

            // Fake Response
            setTimeout(() => {
                 $('#chat-history').append(`
                    <div class="chat-bubble chat-left">
                        <strong class="text-info d-block mb-1"><i class="fas fa-robot me-1"></i> OVERLORD</strong>
                        <span class="typing-indicator">Analiz ediliyor... <i class="fas fa-circle-notch fa-spin small"></i></span>
                    </div>
                `);
                scrollToBottom();
                
                // Real Response Update (Simulated)
                setTimeout(() => {
                    $('#chat-history .typing-indicator').last().parent().html(`
                        <strong class="text-info d-block mb-1"><i class="fas fa-robot me-1"></i> OVERLORD</strong>
                        Anlaşıldı, "${msg}" emri işleme alındı.
                    `);
                    scrollToBottom();
                }, 1500);

            }, 600);
        }

        function scrollToBottom() {
            var chat = document.getElementById("chat-history");
            chat.scrollTop = chat.scrollHeight;
        }

        $('#btn-send-groq').click(sendMessage);
        $('#groq-input').keypress(function(e) {
            if(e.which == 13) sendMessage();
        });
    </script>
}
