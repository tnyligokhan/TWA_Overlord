@model TWA.Web.Models.RecruitmentViewModel
@{
    ViewData["Title"] = "Atölye - Kuşatma Silahları";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1"><i class="fas fa-tools text-info"></i> Atölye</h2>
                        <p class="text-muted mb-0">Kuşatma Silahları Üret</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark border border-secondary text-warning fs-5">Seviye @Model.BuildingLevel</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <label class="form-label text-white fw-bold">Köy Seçin:</label>
                <select class="form-select bg-dark text-white border-secondary" onchange="window.location.href='/Recruitment/Garage?villageId=' + this.value">
                    @foreach (var village in Model.Villages)
                    {
                        <option value="@village.Id" selected="@(village.Id == Model.SelectedVillageId)">
                            @village.Name (@village.Coordinates)
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (Model.SelectedVillage != null)
{
    @await Html.PartialAsync("_BuildingNavbar", Model.SelectedVillage)
    
    var capacity = Model.SelectedVillage.StorageCapacity > 0 ? Model.SelectedVillage.StorageCapacity : 1;
    var woodP = (int)((double)Model.SelectedVillage.Wood / capacity * 100);
    var stoneP = (int)((double)Model.SelectedVillage.Stone / capacity * 100);
    var ironP = (int)((double)Model.SelectedVillage.Iron / capacity * 100);
    var popMax = Model.SelectedVillage.PopulationMax > 0 ? Model.SelectedVillage.PopulationMax : 1;
    var popP = (int)((double)Model.SelectedVillage.PopulationCurrent / popMax * 100);

    <div class="row g-4 mb-4 fade-in-up" style="animation-delay: 0.1s;">
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-tree text-success me-2"></i> Odun</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Wood.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-success progress-bar-animated-striped" style="width: @woodP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-success"></i>@Model.SelectedVillage.WoodHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@woodP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-cubes text-secondary me-2"></i> Kil</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Stone.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-secondary progress-bar-animated-striped" style="width: @stoneP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-secondary"></i>@Model.SelectedVillage.StoneHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@stoneP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-gem text-info me-2"></i> Demir</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Iron.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-info progress-bar-animated-striped" style="width: @ironP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-info"></i>@Model.SelectedVillage.IronHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@ironP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-users text-warning me-2"></i> Nüfus</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.PopulationCurrent</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @popP%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">Max: @Model.SelectedVillage.PopulationMax</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Koç -->
        <div class="col-md-6 mb-4">
            @if (Model.SelectedVillage.ResearchRam > 0)
            {
                <div class="card border-0 bg-glass h-100">
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_ram.webp" width="80" alt="Koç">
                            <h4 class="text-white mt-2">Koç</h4>
                            <p class="text-muted small">Duvar yıkma silahı</p>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                <i class="fas fa-check-circle me-1"></i> Araştırma Lv.@Model.SelectedVillage.ResearchRam
                            </span>
                        </div>
                        
                        <div class="mb-3">
                            <div class="d-flex justify-content-between text-muted small">
                                <span><i class="fas fa-tree text-success"></i> 300</span>
                                <span><i class="fas fa-cubes text-secondary"></i> 200</span>
                                <span><i class="fas fa-gem text-info"></i> 200</span>
                                <span><i class="fas fa-user text-warning"></i> 5</span>
                            </div>
                            <div class="text-center text-muted small mt-2">
                                <i class="fas fa-clock"></i> 60 dakika
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Mevcut:</span>
                                <span class="text-white fw-bold">@(Model.SelectedVillage.OwnedTroops?.Ram ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Kuyrukta:</span>
                                <span class="text-warning fw-bold queue-count" data-unit="ram">0</span>
                            </div>
                        </div>

                        <form method="post" asp-action="Train">
                            <input type="hidden" name="SelectedVillageId" value="@Model.SelectedVillageId" />
                            <input type="hidden" name="BuildingType" value="garage" />
                            <input type="hidden" name="UnitType" value="ram" />
                            
                            <div class="input-group mb-3">
                                <input type="number" name="UnitCount" id="ram-count" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Miktar" min="1" value="1">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-plus"></i> Üret
                                </button>
                            </div>
                        </form>

                        <button class="btn btn-outline-secondary btn-sm w-100 calc-max" 
                                data-unit="ram" data-wood="300" data-stone="200" data-iron="200" data-pop="5">
                            <i class="fas fa-calculator"></i> Maksimum Hesapla
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 bg-glass h-100 opacity-50">
                    <div class="card-body text-center">
                        <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_ram.webp" width="80" alt="Koç" class="opacity-25">
                        <h4 class="text-white mt-2">Koç</h4>
                        <div class="alert alert-warning bg-warning bg-opacity-10 border border-warning mt-3">
                            <i class="fas fa-lock me-2"></i> Araştırılmamış
                        </div>
                        <a href="/Building/Smithy?villageId=@Model.SelectedVillageId" class="btn btn-outline-warning btn-sm mt-2">
                            <i class="fas fa-hammer me-1"></i> Demirci'ye Git
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Mancınık -->
        <div class="col-md-6 mb-4">
            @if (Model.SelectedVillage.ResearchCatapult > 0)
            {
                <div class="card border-0 bg-glass h-100">
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_catapult.webp" width="80" alt="Mancınık">
                            <h4 class="text-white mt-2">Mancınık</h4>
                            <p class="text-muted small">Bina yıkma silahı</p>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                <i class="fas fa-check-circle me-1"></i> Araştırma Lv.@Model.SelectedVillage.ResearchCatapult
                            </span>
                        </div>
                        
                        <div class="mb-3">
                            <div class="d-flex justify-content-between text-muted small">
                                <span><i class="fas fa-tree text-success"></i> 320</span>
                                <span><i class="fas fa-cubes text-secondary"></i> 400</span>
                                <span><i class="fas fa-gem text-info"></i> 100</span>
                                <span><i class="fas fa-user text-warning"></i> 8</span>
                            </div>
                            <div class="text-center text-muted small mt-2">
                                <i class="fas fa-clock"></i> 90 dakika
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Mevcut:</span>
                                <span class="text-white fw-bold">@(Model.SelectedVillage.OwnedTroops?.Catapult ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Kuyrukta:</span>
                                <span class="text-warning fw-bold queue-count" data-unit="catapult">0</span>
                            </div>
                        </div>

                        <form method="post" asp-action="Train">
                            <input type="hidden" name="SelectedVillageId" value="@Model.SelectedVillageId" />
                            <input type="hidden" name="BuildingType" value="garage" />
                            <input type="hidden" name="UnitType" value="catapult" />
                            
                            <div class="input-group mb-3">
                                <input type="number" name="UnitCount" id="catapult-count" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Miktar" min="1" value="1">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-plus"></i> Üret
                                </button>
                            </div>
                        </form>

                        <button class="btn btn-outline-secondary btn-sm w-100 calc-max" 
                                data-unit="catapult" data-wood="320" data-stone="400" data-iron="100" data-pop="8">
                            <i class="fas fa-calculator"></i> Maksimum Hesapla
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 bg-glass h-100 opacity-50">
                    <div class="card-body text-center">
                        <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_catapult.webp" width="80" alt="Mancınık" class="opacity-25">
                        <h4 class="text-white mt-2">Mancınık</h4>
                        <div class="alert alert-warning bg-warning bg-opacity-10 border border-warning mt-3">
                            <i class="fas fa-lock me-2"></i> Araştırılmamış
                        </div>
                        <a href="/Building/Smithy?villageId=@Model.SelectedVillageId" class="btn btn-outline-warning btn-sm mt-2">
                            <i class="fas fa-hammer me-1"></i> Demirci'ye Git
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Üretim Kuyruğu -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 bg-glass">
                <div class="card-header bg-dark border-bottom border-secondary border-opacity-25">
                    <h5 class="mb-0 text-white"><i class="fas fa-list-ul text-warning me-2"></i> Üretim Kuyruğu</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Queue != null && Model.Queue.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.Queue)
                            {
                                <div class="list-group-item bg-glass border-0 border-bottom border-secondary border-opacity-10 @(item.IsActive ? "border-start border-warning border-3" : "")">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center">
                                                <div class="unit-icon-box bg-soft-primary rounded p-2 me-3">
                                                    <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_@(item.UnitType).webp" 
                                                         width="40" alt="@item.UnitType">
                                                </div>
                                                <div>
                                                    <h6 class="text-white mb-0 text-capitalize">@GetUnitName(item.UnitType)</h6>
                                                    <small class="text-muted">
                                                        @if (item.IsActive)
                                                        {
                                                            <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                                                <i class="fas fa-cog fa-spin me-1"></i> Üretiliyor
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary">
                                                                <i class="fas fa-clock me-1"></i> Bekliyor
                                                            </span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <div class="badge bg-primary bg-opacity-25 text-primary border border-primary px-3 py-2">
                                                <i class="fas fa-users me-1"></i>
                                                <span class="fs-6 fw-bold">@item.Amount</span>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="text-center">
                                                <div class="text-warning fw-bold mb-1">
                                                    <i class="fas fa-hourglass-half me-1"></i>
                                                    <span class="countdown-timer" data-endtime="@item.EndTime.ToString("o")">
                                                        Hesaplanıyor...
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 6px;">
                                                    @{
                                                        var totalMinutes = (item.EndTime - item.StartTime).TotalMinutes;
                                                        var elapsedMinutes = (DateTime.Now - item.StartTime).TotalMinutes;
                                                        var progress = totalMinutes > 0 ? (elapsedMinutes / totalMinutes * 100) : 0;
                                                        progress = Math.Max(0, Math.Min(100, progress));
                                                    }
                                                    <div class="progress-bar bg-warning progress-bar-animated" role="progressbar" 
                                                         style="width: @progress%" 
                                                         aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"
                                                         data-starttime="@item.StartTime.ToString("o")"
                                                         data-endtime="@item.EndTime.ToString("o")"></div>
                                                </div>
                                                <small class="text-muted countdown-remaining" data-endtime="@item.EndTime.ToString("o")">
                                                    Hesaplanıyor...
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-times me-1"></i> İptal
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <div class="mb-3">
                                <i class="fas fa-inbox fa-4x opacity-25"></i>
                            </div>
                            <h6 class="text-white-50">Üretim kuyruğu boş</h6>
                            <p class="small mb-0">Yukarıdaki formlardan silah üretebilirsiniz</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@functions {
    string GetUnitName(string unitType)
    {
        return unitType.ToLower() switch
        {
            "ram" => "Koç",
            "catapult" => "Mancınık",
            "knight" => "Şövalye",
            _ => unitType
        };
    }
}

@section Scripts {
    <script>
        // Mevcut kaynaklar (sayfa yüklendiğinde)
        let currentResources = {
            wood: @Model.SelectedVillage.Wood,
            stone: @Model.SelectedVillage.Stone,
            iron: @Model.SelectedVillage.Iron,
            popCurrent: @Model.SelectedVillage.PopulationCurrent,
            popMax: @Model.SelectedVillage.PopulationMax
        };

        // Kuyruk verilerini güncelle
        function updateQueueCounts() {
            const queueCounts = {};
            
            // Tüm kuyruk öğelerini say
            document.querySelectorAll('.list-group-item').forEach(function(item) {
                const unitImg = item.querySelector('img[src*="unit_"]');
                if (unitImg) {
                    const src = unitImg.getAttribute('src');
                    const match = src.match(/unit_(\w+)\.webp/);
                    if (match) {
                        const unitType = match[1];
                        const amountEl = item.querySelector('.fs-6.fw-bold');
                        if (amountEl) {
                            const amount = parseInt(amountEl.textContent) || 0;
                            queueCounts[unitType] = (queueCounts[unitType] || 0) + amount;
                        }
                    }
                }
            });

            // Kuyruk sayılarını güncelle
            document.querySelectorAll('.queue-count').forEach(function(el) {
                const unitType = el.getAttribute('data-unit');
                el.textContent = queueCounts[unitType] || 0;
            });
        }

        // Maksimum hesaplama
        document.querySelectorAll('.calc-max').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const unitType = this.getAttribute('data-unit');
                const woodCost = parseInt(this.getAttribute('data-wood'));
                const stoneCost = parseInt(this.getAttribute('data-stone'));
                const ironCost = parseInt(this.getAttribute('data-iron'));
                const popCost = parseInt(this.getAttribute('data-pop'));

                // Mevcut boş nüfus
                const availablePop = currentResources.popMax - currentResources.popCurrent;

                // Her kaynak için maksimum hesapla
                const maxByWood = Math.floor(currentResources.wood / woodCost);
                const maxByStone = Math.floor(currentResources.stone / stoneCost);
                const maxByIron = Math.floor(currentResources.iron / ironCost);
                const maxByPop = Math.floor(availablePop / popCost);

                // En düşük değeri al
                const maxUnits = Math.max(0, Math.min(maxByWood, maxByStone, maxByIron, maxByPop));

                // Input alanına yaz
                const inputField = document.getElementById(unitType + '-count');
                if (inputField) {
                    inputField.value = maxUnits;
                    
                    // Görsel geri bildirim
                    inputField.classList.add('border-success');
                    setTimeout(function() {
                        inputField.classList.remove('border-success');
                    }, 1000);
                }
            });
        });

        // Geri sayım timer'ları
        function updateCountdowns() {
            document.querySelectorAll('.countdown-timer').forEach(function(element) {
                const endTime = new Date(element.getAttribute('data-endtime'));
                const now = new Date();
                const diff = endTime - now;

                if (diff <= 0) {
                    element.textContent = 'Tamamlandı!';
                    element.classList.add('text-success');
                    element.classList.remove('text-warning');
                } else {
                    const hours = Math.floor(diff / (1000 * 60 * 60));
                    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                    
                    element.textContent = 
                        (hours > 0 ? hours + ':' : '') +
                        String(minutes).padStart(2, '0') + ':' +
                        String(seconds).padStart(2, '0');
                }
            });

            document.querySelectorAll('.countdown-remaining').forEach(function(element) {
                const endTime = new Date(element.getAttribute('data-endtime'));
                const now = new Date();
                const diff = endTime - now;

                if (diff <= 0) {
                    element.textContent = 'Tamamlandı';
                } else {
                    const totalMinutes = Math.floor(diff / (1000 * 60));
                    const hours = Math.floor(totalMinutes / 60);
                    const minutes = totalMinutes % 60;

                    if (hours > 0) {
                        element.textContent = hours + ' saat ' + minutes + ' dk kaldı';
                    } else {
                        element.textContent = minutes + ' dk kaldı';
                    }
                }
            });

            // Progress bar güncelle
            document.querySelectorAll('.progress-bar[data-starttime]').forEach(function(bar) {
                const startTime = new Date(bar.getAttribute('data-starttime'));
                const endTime = new Date(bar.getAttribute('data-endtime'));
                const now = new Date();
                
                const total = endTime - startTime;
                const elapsed = now - startTime;
                const progress = Math.max(0, Math.min(100, (elapsed / total) * 100));
                
                bar.style.width = progress + '%';
                bar.setAttribute('aria-valuenow', progress);
            });
        }

        // İlk yükleme
        updateCountdowns();
        updateQueueCounts();
        
        // Her saniye güncelle
        setInterval(updateCountdowns, 1000);
    </script>
}

