@model TWA.Web.Models.MassRecruitmentViewModel
@{
    ViewData["Title"] = "Toplu Asker Basma";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <h2 class="mb-1"><i class="fas fa-users-cog text-primary"></i> Toplu Asker Basma</h2>
                <p class="text-muted mb-0">Tüm köylerinizde aynı anda asker basın</p>
            </div>
        </div>
    </div>
</div>

<form method="post" asp-action="MassRecruit">
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 bg-glass">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Köy Seçimi</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="selectAll">
                        <label class="form-check-label text-white fw-bold" for="selectAll">
                            Tümünü Seç
                        </label>
                    </div>
                    <hr class="border-secondary">
                    <div style="max-height: 400px; overflow-y: auto;">
                        @foreach (var village in Model.Villages)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input village-checkbox" type="checkbox" 
                                       name="SelectedVillageIds" value="@village.Id" id="village_@village.Id">
                                <label class="form-check-label text-white" for="village_@village.Id">
                                    @village.Name (@village.Coordinates)
                                    <small class="text-muted">
                                        - K:@village.BuildingBarracks A:@village.BuildingStable
                                    </small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 bg-glass mb-3">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="mb-0"><i class="fas fa-shield-alt"></i> Asker Tipi</h5>
                </div>
                <div class="card-body">
                    <select class="form-select bg-dark text-white border-secondary mb-3" name="UnitType" required>
                        <option value="">Asker Tipi Seçin</option>
                        <optgroup label="Kışla">
                            <option value="spear">Mızrakçı</option>
                            <option value="sword">Kılıç Ustası</option>
                            <option value="axe">Baltacı</option>
                        </optgroup>
                        <optgroup label="Ahır">
                            <option value="spy">Casus</option>
                            <option value="light">Hafif Süvari</option>
                            <option value="heavy">Ağır Süvari</option>
                        </optgroup>
                    </select>

                    <div class="mb-3">
                        <label class="form-label text-white">Köy Başına Miktar:</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" 
                               name="UnitCountPerVillage" min="1" value="10" required>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="UseMaxCapacity" id="useMax">
                        <label class="form-check-label text-white" for="useMax">
                            Maksimum Kapasiteyi Kullan
                        </label>
                        <small class="text-muted d-block">Her köyde mevcut kaynaklara göre maksimum asker bas</small>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100">
                <i class="fas fa-rocket"></i> Toplu Basımı Başlat
            </button>
        </div>
    </div>
</form>

<div class="row">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-header bg-transparent border-bottom border-secondary">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> Bilgilendirme</h5>
            </div>
            <div class="card-body">
                <ul class="text-muted mb-0">
                    <li>Toplu basım işlemi seçili tüm köylerde aynı anda gerçekleştirilir</li>
                    <li>Her köyde yeterli kaynak ve nüfus olması gerekir</li>
                    <li>Maksimum kapasite seçilirse, her köyde mevcut kaynaklara göre hesaplama yapılır</li>
                    <li>İşlem sıraya alınır ve arka planda çalışır</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.village-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });

        document.getElementById('useMax').addEventListener('change', function() {
            document.querySelector('input[name="UnitCountPerVillage"]').disabled = this.checked;
        });
    </script>
}
