@model IEnumerable<TWA.Core.Entities.Village>
@{
    ViewData["Title"] = "GARNİZON YÖNETİMİ";
}

<!-- Bağlantı Durumu -->
<div class="connection-indicator position-fixed top-0 end-0 m-3 p-2 bg-dark rounded shadow-lg" style="z-index: 9999;">
    <span class="text-muted">🔄 Bağlanıyor...</span>
</div>

<div class="d-flex justify-content-between align-items-end mb-4 fade-in-up">
    <div>
        <h6 class="text-muted text-uppercase fw-bold mb-1">Askeri Güç</h6>
        <h2 class="fw-bold text-white m-0">Garnizon Durumu</h2>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-danger"><i class="fas fa-crosshairs me-1"></i> Toplu Saldırı</button>
        <button class="btn btn-primary"><i class="fas fa-shield-alt me-1"></i> Savunma Modu</button>
    </div>
</div>

<div class="row g-3">
    @foreach (var village in Model)
    {
        <div class="col-lg-6">
            <div class="card bg-glass border-0" data-garrison-village="@village.Id">
                <div class="card-header bg-dark border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="text-white mb-0">@village.Name</h5>
                        <small class="text-muted font-monospace">@village.Coordinates</small>
                    </div>
                    <span class="badge bg-primary">@(village.OwnedTroops?.Total() ?? 0) Asker</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Mızrakçı -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-primary rounded p-2 mb-2">
                                <i class="fas fa-user-shield fs-4"></i>
                            </div>
                            <div class="troop-spear fw-bold text-white">@(village.OwnedTroops?.Spear ?? 0)</div>
                            <small class="text-muted">Mızrakçı</small>
                        </div>
                        
                        <!-- Kılıççı -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-danger rounded p-2 mb-2">
                                <i class="fas fa-sword fs-4"></i>
                            </div>
                            <div class="troop-sword fw-bold text-white">@(village.OwnedTroops?.Sword ?? 0)</div>
                            <small class="text-muted">Kılıççı</small>
                        </div>
                        
                        <!-- Baltacı -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-warning rounded p-2 mb-2">
                                <i class="fas fa-axe fs-4"></i>
                            </div>
                            <div class="troop-axe fw-bold text-white">@(village.OwnedTroops?.Axe ?? 0)</div>
                            <small class="text-muted">Baltacı</small>
                        </div>
                        
                        <!-- Hafif Süvari -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-info rounded p-2 mb-2">
                                <i class="fas fa-horse fs-4"></i>
                            </div>
                            <div class="troop-light fw-bold text-white">@(village.OwnedTroops?.Light ?? 0)</div>
                            <small class="text-muted">Hafif Süvari</small>
                        </div>
                        
                        <!-- Ağır Süvari -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-secondary rounded p-2 mb-2">
                                <i class="fas fa-horse-head fs-4"></i>
                            </div>
                            <div class="troop-heavy fw-bold text-white">@(village.OwnedTroops?.Heavy ?? 0)</div>
                            <small class="text-muted">Ağır Süvari</small>
                        </div>
                        
                        <!-- Koç -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-success rounded p-2 mb-2">
                                <i class="fas fa-hammer fs-4"></i>
                            </div>
                            <div class="troop-ram fw-bold text-white">@(village.OwnedTroops?.Ram ?? 0)</div>
                            <small class="text-muted">Koç</small>
                        </div>
                        
                        <!-- Mancınık -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-danger rounded p-2 mb-2">
                                <i class="fas fa-bomb fs-4"></i>
                            </div>
                            <div class="troop-catapult fw-bold text-white">@(village.OwnedTroops?.Catapult ?? 0)</div>
                            <small class="text-muted">Mancınık</small>
                        </div>
                        
                        <!-- Misyoner -->
                        <div class="col-3 text-center">
                            <div class="troop-icon-box bg-soft-warning rounded p-2 mb-2">
                                <i class="fas fa-crown fs-4"></i>
                            </div>
                            <div class="troop-snob fw-bold text-white">@(village.OwnedTroops?.Snob ?? 0)</div>
                            <small class="text-muted">Misyoner</small>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
                    <button class="btn btn-sm btn-outline-primary"><i class="fas fa-plus me-1"></i> Asker Üret</button>
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-crosshairs me-1"></i> Saldırı Çık</button>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="~/js/live-data-client.js"></script>
}
