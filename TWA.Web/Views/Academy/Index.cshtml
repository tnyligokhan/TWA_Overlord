@model TWA.Web.Models.AcademyViewModel
@{
    ViewData["Title"] = "Akademi - Altın Sikke";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-1"><i class="fas fa-university text-warning"></i> Akademi</h2>
                        <p class="text-muted mb-0">Altın Sikke Basımı ve Misyoner Eğitimi</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark border border-secondary text-warning fs-5">Seviye @Model.AcademyLevel</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-glass">
            <div class="card-body">
                <label class="form-label text-white fw-bold">Köy Seçin:</label>
                <select class="form-select bg-dark text-white border-secondary" onchange="window.location.href='/Academy/Index?villageId=' + this.value">
                    @foreach (var village in Model.Villages)
                    {
                        <option value="@village.Id" selected="@(village.Id == Model.SelectedVillageId)">
                            @village.Name (@village.Coordinates) - Akademi Lv.@village.BuildingSnob
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (Model.SelectedVillage != null)
{
    @await Html.PartialAsync("_BuildingNavbar", Model.SelectedVillage)
    
    var capacity = Model.SelectedVillage.StorageCapacity > 0 ? Model.SelectedVillage.StorageCapacity : 1;
    var woodP = (int)((double)Model.SelectedVillage.Wood / capacity * 100);
    var stoneP = (int)((double)Model.SelectedVillage.Stone / capacity * 100);
    var ironP = (int)((double)Model.SelectedVillage.Iron / capacity * 100);
    var popMax = Model.SelectedVillage.PopulationMax > 0 ? Model.SelectedVillage.PopulationMax : 1;
    var popP = (int)((double)Model.SelectedVillage.PopulationCurrent / popMax * 100);

    <div class="row g-4 mb-4 fade-in-up" style="animation-delay: 0.1s;">
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-tree text-success me-2"></i> Odun</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Wood.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-success progress-bar-animated-striped" style="width: @woodP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-success"></i>@Model.SelectedVillage.WoodHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@woodP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-cubes text-secondary me-2"></i> Kil</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Stone.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-secondary progress-bar-animated-striped" style="width: @stoneP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-secondary"></i>@Model.SelectedVillage.StoneHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@stoneP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-gem text-info me-2"></i> Demir</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.Iron.ToString("N0")</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-info progress-bar-animated-striped" style="width: @ironP%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-white-50" style="font-size: 0.7rem;" title="Saatlik Üretim">
                            <i class="fas fa-plus me-1 text-info"></i>@Model.SelectedVillage.IronHourly
                        </small>
                        <small class="text-muted" style="font-size: 0.7rem;">@ironP% Dolu</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-glass h-100 card-hover border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-users text-warning me-2"></i> Nüfus</span>
                        <span class="font-monospace text-white">@Model.SelectedVillage.PopulationCurrent</span>
                    </div>
                    <div class="progress bg-dark" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @popP%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">Max: @Model.SelectedVillage.PopulationMax</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-0 bg-glass">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="mb-0"><i class="fas fa-coins text-warning"></i> Altın Sikke Basımı</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/buildings/snob.png" width="120" alt="Akademi">
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-dark border-warning">
                                <div class="card-body text-center">
                                    <h3 class="text-warning mb-0">@Model.AvailableCoins</h3>
                                    <small class="text-muted">Mevcut Sikke</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-dark border-info">
                                <div class="card-body text-center">
                                    <h3 class="text-info mb-0">@Model.CoinsInProduction</h3>
                                    <small class="text-muted">Üretimde</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-info bg-dark text-white mb-4">
                        <i class="fas fa-info-circle"></i> <strong>Bilgi:</strong> Her misyoner için 1 altın sikke gereklidir. Maksimum @Model.MaxCoins sikke basabilirsiniz.
                    </div>

                    <div class="mb-4">
                        <h6 class="text-white mb-3">Maliyet:</h6>
                        <div class="d-flex justify-content-around text-center">
                            <div>
                                <i class="fas fa-tree text-success fa-2x"></i>
                                <p class="text-white mb-0 mt-2">28,000</p>
                                <small class="text-muted">Odun</small>
                            </div>
                            <div>
                                <i class="fas fa-cubes text-secondary fa-2x"></i>
                                <p class="text-white mb-0 mt-2">30,000</p>
                                <small class="text-muted">Kil</small>
                            </div>
                            <div>
                                <i class="fas fa-gem text-info fa-2x"></i>
                                <p class="text-white mb-0 mt-2">25,000</p>
                                <small class="text-muted">Demir</small>
                            </div>
                        </div>
                    </div>

                    @if (Model.AvailableCoins + Model.CoinsInProduction < Model.MaxCoins)
                    {
                        <form method="post" asp-action="MintCoin" asp-route-villageId="@Model.SelectedVillageId">
                            <button type="submit" class="btn btn-warning btn-lg w-100">
                                <i class="fas fa-coins"></i> Altın Sikke Bas
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100" disabled>
                            <i class="fas fa-check"></i> Maksimum Sikke Sayısına Ulaşıldı
                        </button>
                    }

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Snob", "Recruitment", new { villageId = Model.SelectedVillageId })" 
                           class="btn btn-outline-warning">
                            <i class="fas fa-crown"></i> Misyoner Bas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
