@model TWA.Core.Entities.Village
@{
    ViewData["Title"] = Model.Name;
    
    // Güvenli Yüzdelik Hesaplamalar
    // Ensure denominator is not zero
    long capacity = Model.StorageCapacity > 0 ? Model.StorageCapacity : 1;
    int woodP = (int)((double)Model.Wood / capacity * 100);
    int stoneP = (int)((double)Model.Stone / capacity * 100);
    int ironP = (int)((double)Model.Iron / capacity * 100);
    
    long popMax = Model.PopulationMax > 0 ? Model.PopulationMax : 1;
    int popP = (int)((double)Model.PopulationCurrent / popMax * 100);
}

<div class="card border-0 mb-4 bg-glass overflow-hidden position-relative fade-in-up">
    <div class="position-absolute top-0 end-0 p-3 opacity-10">
        <i class="fas fa-chess-rook fa-10x text-white"></i>
    </div>
    
    <div class="card-body p-4 position-relative z-index-1">
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h1 class="display-5 fw-bold text-white mb-0">@Model.Name</h1>
                    <span class="badge bg-soft-primary border border-primary border-opacity-25 fs-6">
                        <i class="fas fa-map-marker-alt me-1"></i> @Model.Coordinates
                    </span>
                </div>
                <div class="text-muted d-flex gap-4">
                    <span><i class="fas fa-star text-warning me-1"></i> Puan: <strong class="text-white">@Model.Points.ToString("N0")</strong></span>
                    <span><i class="fas fa-heart text-danger me-1"></i> Sadakat: <strong class="text-white">@Model.Loyalty</strong></span>
                    <span><i class="fas fa-shield-alt text-success me-1"></i> Durum: <strong class="text-success">GÜVENLİ</strong></span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Infrastructure", new { villageId = Model.Id })" class="btn btn-outline-primary">
                    <i class="fas fa-hard-hat me-2"></i> Altyapı
                </a>
                <a href="@Url.Action("Index", "Garrison", new { villageId = Model.Id })" class="btn btn-outline-danger">
                    <i class="fas fa-shield-alt me-2"></i> Garnizon
                </a>
                <a href="@Url.Action("Barracks", "Recruitment", new { villageId = Model.Id })" class="btn btn-outline-success">
                    <i class="fas fa-user-plus me-2"></i> Asker Bas
                </a>
                <a href="@Url.Action("Index", "Market", new { villageId = Model.Id })" class="btn btn-outline-warning">
                    <i class="fas fa-store me-2"></i> Pazar
                </a>
                <button class="btn btn-outline-light border-secondary hover-white" onclick="location.reload()">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="progress" style="height: 2px; background: transparent;">
        <div class="progress-bar bg-primary" style="width: 100%"></div>
    </div>
</div>

<div class="row g-4 mb-4 fade-in-up" style="animation-delay: 0.1s;">
    <div class="col-md-3">
        <div class="card border-0 bg-glass h-100 card-hover">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-tree text-success me-2"></i> Odun</span>
                    <span class="font-monospace text-white">@((Model.Wood/1000.0).ToString("0.0"))k</span>
                </div>
                <div class="progress bg-dark" style="height: 6px;">
                    <div class="progress-bar bg-success progress-bar-animated-striped" style="width: @woodP%"></div>
                </div>
                <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">@woodP% Dolu</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass h-100 card-hover">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-cubes text-secondary me-2"></i> Kil</span>
                    <span class="font-monospace text-white">@((Model.Stone/1000.0).ToString("0.0"))k</span>
                </div>
                <div class="progress bg-dark" style="height: 6px;">
                    <div class="progress-bar bg-secondary progress-bar-animated-striped" style="width: @stoneP%"></div>
                </div>
                <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">@stoneP% Dolu</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass h-100 card-hover">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-gem text-info me-2"></i> Demir</span>
                    <span class="font-monospace text-white">@((Model.Iron/1000.0).ToString("0.0"))k</span>
                </div>
                <div class="progress bg-dark" style="height: 6px;">
                    <div class="progress-bar bg-info progress-bar-animated-striped" style="width: @ironP%"></div>
                </div>
                <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">@ironP% Dolu</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-glass h-100 card-hover border-start border-4 @(popP > 95 ? "border-danger" : "border-warning")">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold"><i class="fas fa-users text-warning me-2"></i> Nüfus</span>
                    <span class="font-monospace text-white">@Model.PopulationCurrent</span>
                </div>
                <div class="progress bg-dark" style="height: 6px;">
                    <div class="progress-bar bg-warning" style="width: @popP%"></div>
                </div>
                <small class="text-muted mt-2 d-block text-end" style="font-size: 0.7rem;">Max: @Model.PopulationMax</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 fade-in-up" style="animation-delay: 0.2s;">
    <div class="col-lg-7">
        <div class="card border-0 bg-glass">
            <div class="card-header bg-dark bg-opacity-50 border-bottom border-danger border-opacity-50 py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-danger fw-bold"><i class="fas fa-shield-alt me-2"></i> GARNİZON KUVVETLERİ</h6>
                </div>
            </div>
            <div class="card-body p-2">
                <div class="row g-2">
                    @functions {
                        void RenderTroopCard(string name, int count, string unitType) {
                            <div class="col-3">
                                <div class="troop-mini-card bg-dark bg-opacity-50 rounded-2 p-2 text-center border border-secondary border-opacity-25 hover-lift">
                                    <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_@(unitType).webp" 
                                         width="36" height="36" alt="@name" class="mb-1">
                                    <div class="fw-bold text-white" style="font-size: 0.95rem;">@count</div>
                                    <small class="text-muted text-uppercase" style="font-size: 0.6rem; letter-spacing: 0.5px;">@name</small>
                                </div>
                            </div>
                        }
                    }

                    @{
                        var troops = Model.OwnedTroops ?? new TWA.Core.Entities.TroopSet();
                        
                        RenderTroopCard("Mızrak", troops.Spear, "spear");
                        RenderTroopCard("Kılıç", troops.Sword, "sword");
                        RenderTroopCard("Balta", troops.Axe, "axe");
                        RenderTroopCard("Casus", troops.Spy, "spy");
                        RenderTroopCard("Hafif", troops.Light, "light");
                        RenderTroopCard("Ağır", troops.Heavy, "heavy");
                        RenderTroopCard("Koç", troops.Ram, "ram");
                        RenderTroopCard("Mancınık", troops.Catapult, "catapult");
                        RenderTroopCard("Şövalye", troops.Knight, "knight");
                        RenderTroopCard("Misyoner", troops.Snob, "snob");
                    }
                </div>
            </div>
        </div>
        
        <!-- Üretim Binaları -->
        <div class="card border-0 bg-glass mt-3">
            <div class="card-header bg-dark bg-opacity-50 border-bottom border-success border-opacity-50 py-2">
                <h6 class="mb-0 text-success fw-bold"><i class="fas fa-industry me-2"></i> ÜRETİM BİNALARI</h6>
            </div>
            <div class="card-body p-2">
                <div class="row g-2">
                    @if (Model.BuildingBarracks > 0)
                    {
                        <!-- Kışla -->
                        <div class="col-6">
                            <a href="@Url.Action("Barracks", "Recruitment", new { villageId = Model.Id })" class="text-decoration-none">
                                <div class="building-card bg-dark bg-opacity-50 rounded-2 p-3 border border-secondary border-opacity-25 hover-lift">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="building-icon bg-danger bg-opacity-25 rounded-circle p-2" style="width: 48px; height: 48px;">
                                            <i class="fas fa-dungeon text-danger fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="text-white mb-0">Kışla</h6>
                                            <small class="text-muted">Piyade Üretimi</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-dark border border-danger text-danger">Lvl @Model.BuildingBarracks</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    @if (Model.BuildingStable > 0)
                    {
                        <!-- Ahır -->
                        <div class="col-6">
                            <a href="@Url.Action("Stable", "Recruitment", new { villageId = Model.Id })" class="text-decoration-none">
                                <div class="building-card bg-dark bg-opacity-50 rounded-2 p-3 border border-secondary border-opacity-25 hover-lift">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="building-icon bg-primary bg-opacity-25 rounded-circle p-2" style="width: 48px; height: 48px;">
                                            <i class="fas fa-horse text-primary fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="text-white mb-0">Ahır</h6>
                                            <small class="text-muted">Süvari Üretimi</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-dark border border-primary text-primary">Lvl @Model.BuildingStable</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    @if (Model.BuildingGarage > 0)
                    {
                        <!-- Atölye -->
                        <div class="col-6">
                            <a href="@Url.Action("Garage", "Recruitment", new { villageId = Model.Id })" class="text-decoration-none">
                                <div class="building-card bg-dark bg-opacity-50 rounded-2 p-3 border border-secondary border-opacity-25 hover-lift">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="building-icon bg-info bg-opacity-25 rounded-circle p-2" style="width: 48px; height: 48px;">
                                            <i class="fas fa-tools text-info fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="text-white mb-0">Atölye</h6>
                                            <small class="text-muted">Kuşatma Silahları</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-dark border border-info text-info">Lvl @Model.BuildingGarage</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    @if (Model.BuildingSmithy > 0)
                    {
                        <!-- Demirci -->
                        <div class="col-6">
                            <a href="@Url.Action("Index", "Smithy", new { villageId = Model.Id })" class="text-decoration-none">
                                <div class="building-card bg-dark bg-opacity-50 rounded-2 p-3 border border-secondary border-opacity-25 hover-lift">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="building-icon bg-warning bg-opacity-25 rounded-circle p-2" style="width: 48px; height: 48px;">
                                            <i class="fas fa-hammer text-warning fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="text-white mb-0">Demirci</h6>
                                            <small class="text-muted">Asker Geliştirme</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-dark border border-warning text-warning">Lvl @Model.BuildingSmithy</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }

                    @if (Model.BuildingSnob > 0)
                    {
                        <!-- Akademi -->
                        <div class="col-6">
                            <a href="@Url.Action("Snob", "Recruitment", new { villageId = Model.Id })" class="text-decoration-none">
                                <div class="building-card bg-dark bg-opacity-50 rounded-2 p-3 border border-secondary border-opacity-25 hover-lift">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="building-icon bg-secondary bg-opacity-25 rounded-circle p-2" style="width: 48px; height: 48px;">
                                            <i class="fas fa-crown text-secondary fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="text-white mb-0">Akademi</h6>
                                            <small class="text-muted">Misyoner Üretimi</small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-dark border border-secondary text-secondary">Lvl @Model.BuildingSnob</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <!-- Asker Kuyruğu -->
        <div class="card border-0 bg-glass mt-3">
            <div class="card-header bg-dark bg-opacity-50 border-bottom border-success border-opacity-50 py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-success fw-bold"><i class="fas fa-clock me-2"></i> ASKER KUYRUĞU</h6>
                    @{
                        var queue = ViewBag.RecruitmentQueue as List<TWA.Core.DTOs.RecruitmentQueueItem> ?? new List<TWA.Core.DTOs.RecruitmentQueueItem>();
                    }
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-2 py-1">
                        @queue.Count Sırada
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (queue.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in queue.Take(5))
                        {
                            <div class="list-group-item bg-transparent border-secondary border-opacity-10 py-2 px-3 @(item.IsActive ? "border-start border-success border-3" : "")">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="position-relative">
                                            <img src="https://dstr.innogamescdn.com/asset/c645ceed/graphic/unit/unit_@(item.UnitType).webp" 
                                                 width="40" height="40" alt="@item.UnitType">
                                            @if (item.IsActive)
                                            {
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success">
                                                    <i class="fas fa-cog fa-spin" style="font-size: 0.6rem;"></i>
                                                </span>
                                            }
                                        </div>
                                        <div>
                                            <div class="text-white fw-bold" style="font-size: 0.9rem;">
                                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary me-1">@item.Amount</span>
                                                @GetUnitName(item.UnitType)
                                            </div>
                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                @if (item.IsActive)
                                                {
                                                    <span class="text-success">Üretiliyor</span>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">Bekliyor</span>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-warning fw-bold countdown-timer" style="font-size: 0.85rem;" data-endtime="@item.EndTime.ToString("o")">
                                            --:--:--
                                        </div>
                                        <small class="text-muted" style="font-size: 0.65rem;">
                                            <i class="far fa-clock me-1"></i>@item.EndTime.ToString("HH:mm")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (queue.Count > 5)
                    {
                        <div class="text-center py-2 border-top border-secondary border-opacity-10 bg-dark bg-opacity-25">
                            <small class="text-muted"><i class="fas fa-ellipsis-h me-1"></i> +@(queue.Count - 5) daha fazla kuyrukta</small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-3x opacity-10 mb-2"></i>
                        <p class="small mb-0 text-white-50">Asker kuyruğu boş</p>
                        <a href="@Url.Action("Barracks", "Recruitment", new { villageId = Model.Id })" class="btn btn-sm btn-outline-success mt-2">
                            <i class="fas fa-plus me-1"></i> Asker Bas
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        
        @functions {
            string GetUnitName(string unitType)
            {
                return unitType.ToLower() switch
                {
                    "spear" => "Mızrakçı",
                    "sword" => "Kılıç Ustası",
                    "axe" => "Baltacı",
                    "spy" => "Casus",
                    "light" => "Hafif Süvari",
                    "heavy" => "Ağır Süvari",
                    "ram" => "Koç",
                    "catapult" => "Mancınık",
                    "knight" => "Şövalye",
                    "snob" => "Misyoner",
                    _ => unitType
                };
            }
        }
        
        <div class="card border-0 bg-glass mb-4 border-start border-4 border-info">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="icon-box bg-soft-info rounded-circle animate-pulse">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h6 class="fw-bold text-info mb-0">OVERLORD AI ANALİZİ</h6>
                </div>
                <div class="bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-25 font-monospace text-muted small" style="min-height: 80px;">
                    <span class="text-success">root@twa:~$</span> <span id="ai-output" class="text-light">Analiz başlatılıyor...</span><span class="blink">_</span>
                </div>
                <button class="btn btn-sm btn-outline-info w-100 mt-2" id="btn-ask-groq" data-id="@Model.Id">
                    <i class="fas fa-magic me-2"></i> Taktiksel Öneri İste
                </button>
            </div>
        </div>

        <div class="card border-0 bg-glass">
            <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-warning"><i class="fas fa-city me-2"></i> KRİTİK ALTYAPI</span>
                <a href="@Url.Action("Index", "Infrastructure", new { villageId = Model.Id })" class="btn btn-xs btn-outline-warning border-0">
                    <i class="fas fa-hammer me-1"></i> Yönet
                </a>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <div class="list-group-item bg-transparent border-secondary border-opacity-10 d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-soft-warning rounded-circle" style="width: 36px; height: 36px;"><i class="fas fa-home fa-sm"></i></div>
                            <div>
                                <div class="text-white fw-bold small">Ana Bina</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Yönetim Merkezi</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-dark border border-secondary text-warning">Lvl @Model.BuildingMain</span>
                        </div>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary border-opacity-10 d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-soft-danger rounded-circle" style="width: 36px; height: 36px;"><i class="fas fa-dungeon fa-sm"></i></div>
                            <div>
                                <div class="text-white fw-bold small">Kışla</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Piyade Üretimi</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-dark border border-secondary text-danger">Lvl @Model.BuildingBarracks</span>
                        </div>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary border-opacity-10 d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-soft-info rounded-circle" style="width: 36px; height: 36px;"><i class="fas fa-horse fa-sm"></i></div>
                            <div>
                                <div class="text-white fw-bold small">Ahır</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Süvari Üretimi</div>
                            </div>
                        </div>
                        <div class="text-end d-flex align-items-center gap-2">
                            <span class="badge bg-dark border border-secondary text-info">Lvl @Model.BuildingStable</span>
                            <a href="@Url.Action("Stable", "Recruitment", new { villageId = Model.Id })" class="btn btn-xs btn-outline-info">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary border-opacity-10 d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-soft-secondary rounded-circle" style="width: 36px; height: 36px;"><i class="fas fa-tools fa-sm"></i></div>
                            <div>
                                <div class="text-white fw-bold small">Atölye</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Kuşatma Silahları</div>
                            </div>
                        </div>
                        <div class="text-end d-flex align-items-center gap-2">
                            <span class="badge bg-dark border border-secondary text-secondary">Lvl @Model.BuildingGarage</span>
                            <a href="@Url.Action("Garage", "Recruitment", new { villageId = Model.Id })" class="btn btn-xs btn-outline-secondary">
                                <i class="fas fa-plus"></i>
                            </a>
                        </div>
                    </div>

                    <div class="list-group-item bg-transparent border-secondary border-opacity-10 d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box bg-soft-warning rounded-circle" style="width: 36px; height: 36px;"><i class="fas fa-hammer fa-sm"></i></div>
                            <div>
                                <div class="text-white fw-bold small">Demirci</div>
                                <div class="text-muted" style="font-size: 0.7rem;">Asker Geliştirme</div>
                            </div>
                        </div>
                        <div class="text-end d-flex align-items-center gap-2">
                            <span class="badge bg-dark border border-secondary text-warning">Lvl @Model.BuildingSmithy</span>
                            <a href="@Url.Action("Index", "Smithy", new { villageId = Model.Id })" class="btn btn-xs btn-outline-warning">
